	(text "sensitivity = -44dB ==> 10^(-44/20) = 6.31mVrms per pascal = +-89mV\n178mV range to 3.3V range ==> 3.3/.178 = gain of 18.5 (make it 18 to not clip) (\nto make sure it doesnt clip at the bottom, need to add >89 mV bias , then gain of that doesnt make it > 3.3V\nadd 100mV (gain of 17)\n\n"
		(exclude_from_sim no)
		(at 196.596 150.876 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4f8ac637-c636-468f-b39e-3e425e5dc733")
	)
